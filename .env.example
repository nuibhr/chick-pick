# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LINE Login / LIFF: use the LINE Login channel ID (public numeric ID),
# and the LIFF app ID registered on an HTTPS URL ending in /miniapp.
# Never put a LINE channel secret in a VITE_ variable.
LINE_CHANNEL_ID=""
VITE_LIFF_ID=""

# TiDB Cloud Starter/Essential public connection URL from the Connect dialog.
# It must start with mysql:// and is used server-side only. TLS 1.2+ is enforced.
TIDB_DATABASE_URL=""

# Production writes are enabled only when this is true and TiDB + LINE are ready.
APP_LIVE_MODE="false"

# One-time organizer password for the first HTTPS login. Use 12+ random characters.
# Remove this environment variable after the first admin credential is stored in TiDB.
ADMIN_SETUP_TOKEN=""

# Optional private Hugging Face Gradio Space or raw /ocr endpoint.
# For a Space, use its base URL such as https://owner-space.hf.space.
# Keep the token server-side; never use a VITE_ prefix for it.
HF_OCR_ENDPOINT_URL=""
HF_OCR_TOKEN=""

# Active Cloudflare receipt verification. Store the key as a Worker secret, never VITE_.
SLIPOK_BRANCH_ID="77946"
SLIPOK_API_KEY=""

# Cloudflare TiDB payment adapter: use server-side Worker secrets, never VITE_ keys.
# Legacy Stripe records only. New Checkout is disabled; keep these until old QR records are reconciled.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PUBLIC_APP_URL="https://chick-pick-tidb-staging.nuibhr1.workers.dev"

# Finance admin: create the password at /?admin=1; hashed in data/admin.json.

# DUPR Partner API: server-only credentials, issued by DUPR. Never use VITE_ names.
# Leave all empty until API access is approved. Confirm the production API URL with DUPR.
# Documented sandbox URL: https://uat.mydupr.com/api
DUPR_API_BASE_URL=""
DUPR_CLIENT_KEY=""
DUPR_CLIENT_SECRET=""
