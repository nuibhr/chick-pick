{
  "name": "chick-pick",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22 <26"
  },
  "type": "module",
  "scripts": {
    "test": "node scripts/runTests.mjs",
    "security:secrets": "node scripts/checkSecrets.mjs",
    "backup:init": "node scripts/cloudBackup.mjs init",
    "backup:create": "node scripts/cloudBackup.mjs create",
    "backup:verify": "node scripts/cloudBackup.mjs verify",
    "backup:restore": "node scripts/cloudBackup.mjs restore",
    "backup:drill": "node scripts/cloudBackup.mjs drill",
    "dev": "tsx server.marketplace.ts",
    "build": "vite build && esbuild server.marketplace.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:cloudflare": "node scripts/checkPublicAssets.mjs && vite build --outDir dist-client",
    "start": "node dist/server.cjs",
    "db:migrate": "tsx server/migrateTidb.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@line/liff": "^2.31.2",
    "@tailwindcss/vite": "^4.1.14",
    "@tidbcloud/serverless": "^0.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.6",
    "promptpay-qr": "^0.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^22.6.2",
    "three": "^0.187.0",
    "vite": "^6.4.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
